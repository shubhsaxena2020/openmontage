{
  "name": "openmontage-remotion-hud",
  "version": "0.1.0",
  "description": "Fitness HUD + Kinetic Studio final composite (Remotion) for OpenMontage.",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.tsx",
    "studio": "remotion studio src/studio-entry.tsx",
    "render-hud": "remotion render src/index.tsx FitnessHUD out/hud.mp4",
    "render-studio": "remotion render src/studio-entry.tsx StudioComposition out/studio_short.mp4",
    "build": "remotion bundle src/index.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remotion": "4.0.518",
    "@remotion/cli": "4.0.518",
    "@remotion/player": "4.0.518",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "typescript": "5.4.5"
  }
}
