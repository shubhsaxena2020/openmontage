{
  "name": "kinetic_studio",
  "description": "Kinetic Studio tool chain (engine layer). The full product (incl. Remotion final composite + branding) is driven by kinetic_studio/orchestrator.py; this declarative def runs the same 6-tool chain via the pipeline runner for CI / headless smoke tests.",
  "inputs": {
    "clip": "samples/samples/athlete_16x9.mp4",
    "boxes": "samples/samples/boxes.json",
    "music": "samples/samples/beat_120bpm.wav",
    "speech": "samples/samples/speech.wav"
  },
  "steps": [
    { "id": "beats", "tool": "beat_drop_mapper",
      "params": { "audio_path": "${inputs.music}", "out_json": "ks_beats.json" }, "out": "ks_beats.json", "primary": "json" },
    { "id": "energy", "tool": "motion_energy",
      "params": { "input_path": "${inputs.clip}", "method": "diff", "out_json": "ks_energy.json" }, "out": "ks_energy.json", "primary": "json" },
    { "id": "pose", "tool": "fitness_pose",
      "params": { "input_path": "${inputs.clip}", "model": "yolov8n-pose.pt", "max_frames": 60, "out_json": "ks_pose.json" }, "out": "ks_pose.json", "primary": "json" },
    { "id": "ramper", "tool": "kinetic_ramper",
      "params": { "input_path": "${inputs.clip}", "map_json": "${beats.json}", "out_path": "ks_ramped.mp4", "setup_speed": 1.6, "peak_speed": 0.4 }, "out": "ks_ramped.mp4" },
    { "id": "reframe", "tool": "smart_reframe",
      "params": { "input_path": "${inputs.clip}", "boxes_json": "${inputs.boxes}", "out_path": "ks_reframed.mp4", "target_w": 540, "alpha": 0.25, "deadband": 6 }, "out": "ks_reframed.mp4" },
    { "id": "captions", "tool": "kinetic_word_sync",
      "params": { "audio_path": "${inputs.speech}", "model": "tiny", "language": "en", "out_json": "ks_captions.json" }, "out": "ks_captions.json", "primary": "json" }
  ]
}
